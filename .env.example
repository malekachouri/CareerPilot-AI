# Copy to .env and adjust. Never commit .env.

# dev | test | prod  (prod refuses to start with insecure defaults)
ENV=dev

# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# Must be true behind HTTPS (required in prod)
COOKIE_SECURE=false

# Set to false for a personal / invite-only instance, then create your admin account with:
#   docker compose run --rm api careerpilot create-admin --email you@example.org
REGISTRATION_OPEN=true

POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

LOG_LEVEL=INFO
WEB_PORT=3000

# Local clone of the PRIVATE repository careerpilot-private-content (used from phase 1).
PRIVATE_CONTENT_DIR=../careerpilot-private-content/captures

# Question generator (local model, Ollama). Start it with: docker compose --profile ai up -d
# qwen3:4b needs ~4 GB of free RAM. With less, use qwen3:1.7b (~2 GB) or qwen3:0.6b (~1 GB), then:
#   docker compose exec ollama ollama pull <model>   and   docker compose up -d
LLM_MODEL=qwen3:4b
# Smaller context = less RAM. Raise the timeout on slow machines.
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=300
# Embeddings for the coach's knowledge base (768-d). Empty = keyword search only.
EMBEDDING_MODEL=nomic-embed-text
# Optional, free: raises GitHub's API rate limit for repository imports. Never commit it.
GITHUB_TOKEN=
