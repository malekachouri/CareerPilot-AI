# Copy to .env and adjust. Never commit .env.

# dev | test | prod  (prod refuses to start with insecure defaults)
ENV=dev

# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# Must be true behind HTTPS (required in prod)
COOKIE_SECURE=false

# Set to false for a personal / invite-only instance, then create your admin account with:
#   docker compose run --rm api careerpilot create-admin --email you@example.org
REGISTRATION_OPEN=true

POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
POSTGRES_DB=careerpilot

LOG_LEVEL=INFO
WEB_PORT=3000

# Local clone of the PRIVATE repository careerpilot-private-content (used from phase 1).
PRIVATE_CONTENT_DIR=../careerpilot-private-content/captures
